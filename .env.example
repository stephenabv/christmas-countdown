# URL of the song played when the Christmas season begins.
# Any YouTube URL form works: watch?v=..., youtu.be/..., or /embed/...
# Defaults to Mariah Carey - "All I Want for Christmas Is You" when unset.
NEXT_PUBLIC_CHRISTMAS_SONG_URL=https://www.youtube.com/watch?v=aAkMkVFwAoo

# Optional: override the season start. Defaults to September 1, 00:00 Philippine time.
# NEXT_PUBLIC_SEASON_START_MONTH=9
# NEXT_PUBLIC_SEASON_START_DAY=1
